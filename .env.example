# ── SUPABASE DATABASE CONFIGURATION ───────────────────────────────────────────
# Transaction pooler URL (port 6543) for runtime queries via Prisma Client.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session pooler URL (port 5432 on pooler host, NOT db.<ref>.supabase.co direct host which is IPv6-only).
# Used for Prisma migrations (prisma migrate deploy / status). Required for scripts and migrations, optional at app runtime.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── SUPABASE SERVER-ONLY CONFIGURATION ─────────────────────────────────────────
# Server-only keys for backend OTP dispatch and verification (signInWithOtp and verifyOtp).
# NEVER expose these in client-side code and do NOT prefix with NEXT_PUBLIC_.
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# ── DATABASE SEED SAFETY GUARDS ───────────────────────────────────────────────
# ALLOW_SEED must explicitly be set to "true" to run prisma/seed.ts. Refuses to run if NODE_ENV=production.
ALLOW_SEED="false"
# Must match the project ref in DATABASE_URL (the segment after "postgres.") exactly.
SEED_ALLOWED_PROJECT_REF="[project-ref]"

# ── NEXTAUTH AUTHENTICATION CONFIGURATION ────────────────────────────────────
NEXTAUTH_SECRET="your-nextauth-secret-string"
NEXTAUTH_URL="http://localhost:3000"

# ── GOOGLE OAUTH CONFIGURATION ──────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── EMAIL OTP CONFIGURATION (RESEND API - OPTIONAL/BACKUP) ───────────────────
RESEND_API_KEY="your-resend-api-key"

# ── CLOUDINARY UPLOAD CONFIGURATION ─────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-cloudinary-unsigned-preset"
